# Public base URL used to build password-reset links (include https:// in production)
APP_URL=https://your-markaz-domain.example

# Gmail SMTP (use a Google App Password, never your normal Google password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-markaz-gmail@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password

# Gmail normally requires the sender to match the authenticated account.
# Change this only to a sender address configured as an allowed Gmail alias.
MAIL_FROM=your-markaz-gmail@gmail.com
MAIL_FROM_NAME=MARKAZ
