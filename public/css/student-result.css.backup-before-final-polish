/* =========================================================
   PRINT
   ========================================================= */

@media print {
  body {
    background: #fff !important;
  }

  .report-card {
    width: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .page-header,
  .header-actions,
  button,
  .btn {
    display: none !important;
  }

  .school-header,
  .session-bar,
  .performance-card,
