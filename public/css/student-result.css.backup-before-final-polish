/* =========================================================
   MARKAZ 2026 — MODERN MANAGEMENT UI
   PART 1/3
   ========================================================= */

:root {
  --mk-green: #087f5b;
  --mk-green-dark: #075c43;
  --mk-green-deep: #043d2d;
  --mk-green-soft: #eaf7f1;
  --mk-gold: #c99a24;
  --mk-gold-soft: #fff7df;
  --mk-ink: #17231e;
  --mk-muted: #6b7771;
  --mk-line: #e2e9e5;
  --mk-bg: #f4f7f5;
  --mk-white: #ffffff;
  --mk-shadow: 0 8px 28px rgba(9, 55, 39, .08);
  --mk-shadow-hover: 0 14px 34px rgba(9, 55, 39, .13);
}

/* MAIN MANAGEMENT BACKGROUND */
body {
  background:
    radial-gradient(circle at 8% 0%, rgba(8,127,91,.08), transparent 26%),
    radial-gradient(circle at 95% 12%, rgba(201,154,36,.07), transparent 22%),
    var(--mk-bg);
  color: var(--mk-ink);
}

/* REPORT CARD */
.report-card {
  background: var(--mk-white);
  border: 1px solid rgba(8,127,91,.08);
  box-shadow: var(--mk-shadow);
}

/* HEADER */
.page-header {
  background: rgba(255,255,255,.96);
  border-bottom: 1px solid var(--mk-line);
}

.page-header h1,
.page-header h2 {
  color: var(--mk-green-deep);
  letter-spacing: -.02em;
}

/* SCHOOL HEADER */
.school-header {
  background:
    linear-gradient(120deg,
      #043d2d 0%,
      #075c43 52%,
      #087f5b 100%);
  min-height: 150px;
}

.school-header .school-logo {
  width: 78px;
  height: 78px;
  padding: 3px;
  object-fit: contain;
  background: #fff;
  border: 3px solid rgba(255,255,255,.85);
  box-shadow: 0 8px 22px rgba(0,0,0,.18);
}

/* SESSION BAR */
.session-bar {
  background: linear-gradient(90deg, #fff8df, #fffdf4);
  border-bottom: 1px solid #eadcae;
  color: #725708;
}

/* STUDENT INFORMATION */
.student-profile,
.student-information {
  background: linear-gradient(135deg, #ffffff, #f7faf8);
  border-color: var(--mk-line);
  box-shadow: 0 4px 15px rgba(9,55,39,.045);
}

.student-profile h2,
.student-profile h3 {
  color: var(--mk-green-deep);
}

.student-meta span {
  background: var(--mk-green-soft);
  border-color: #d2eadf;
  color: var(--mk-green-dark);
}

/* PERFORMANCE CARDS */
.performance-card {
  background: #fff;
  border-color: var(--mk-line);
  box-shadow: 0 5px 18px rgba(9,55,39,.055);
}

.performance-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--mk-shadow-hover);
}

.performance-card::before {
  width: 5px;
  background: linear-gradient(180deg, var(--mk-green), var(--mk-gold));
}

.performance-card .value {
  color: var(--mk-green-deep);
}

/* MANAGEMENT COLUMNS */
.result-management-grid {
  align-items: start;
  gap: 20px;
}

.management-panel {
  background: #fff;
  border: 1px solid var(--mk-line);
  border-radius: 18px;
  box-shadow: var(--mk-shadow);
}

.academic-management-panel {
  border-top: 4px solid var(--mk-green);
}

.behavioural-management-panel {
  border-top: 4px solid var(--mk-gold);
}

/* SECTION HEADINGS */
.section-heading {
  padding-bottom: 12px;
  border-bottom: 1px solid var(--mk-line);
}

.section-heading::before {
  background: linear-gradient(180deg, var(--mk-green), var(--mk-gold));
}

.section-heading h2,
.section-heading h3,
.section-heading strong {
  color: var(--mk-green-deep);
}

/* ACTIVE PANEL LABELS */
.academic-management-panel .section-heading {
  background: linear-gradient(90deg, rgba(8,127,91,.045), transparent);
}

.behavioural-management-panel .section-heading {
  background: linear-gradient(90deg, rgba(201,154,36,.07), transparent);
}

/* MOBILE */
@media (max-width: 850px) {
  .result-management-grid {
    gap: 14px;
  }

  .management-panel {
    border-radius: 15px;
  }
}


/* =========================================================
   MARKAZ 2026 — RESULTS WORKSPACE
   PART 2/3
   ========================================================= */

/* RESULTS TABLE SHELL */
.results-table-container {
  background: #fff;
  border: 1px solid #dfe8e3;
  border-radius: 14px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.8);
}

/* TABLE */
.student-results-table {
  border-collapse: separate;
  border-spacing: 0;
}

.student-results-table thead th {
  background: linear-gradient(180deg, #f1f8f4, #e7f2ed);
  color: #075c43;
  border-bottom: 2px solid #c9dfd5;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: .045em;
  padding: 12px 10px;
  white-space: nowrap;
}

.student-results-table tbody td {
  background: #fff;
  border-bottom: 1px solid #edf1ef;
  padding: 10px;
  color: #334039;
  vertical-align: middle;
}

.student-results-table tbody tr:nth-child(even) td {
  background: #fbfdfc;
}

.student-results-table tbody tr:hover td {
  background: #f0faf5;
}

/* SUBJECT NAME */
.student-results-table tbody td:first-child {
  color: #064b37;
  font-weight: 750;
}

/* SCORE CELLS */
.student-results-table input[type="number"],
.student-results-table input[type="text"],
.student-results-table select {
  min-height: 38px;
  border: 1px solid #ccd9d2;
  border-radius: 8px;
  background: #fff;
  color: #17231e;
  font-weight: 750;
  outline: none;
  transition: .18s ease;
}

.student-results-table input[type="number"] {
  width: 70px;
  text-align: center;
}

.student-results-table input[type="number"]:hover,
.student-results-table input[type="text"]:hover,
.student-results-table select:hover {
  border-color: #8ebaa8;
  background: #fbfefc;
}

.student-results-table input[type="number"]:focus,
.student-results-table input[type="text"]:focus,
.student-results-table select:focus {
  border-color: #087f5b;
  box-shadow: 0 0 0 3px rgba(8,127,91,.12);
  background: #fff;
}

/* TOTAL */
.student-results-table td.total,
.student-results-table td:nth-last-child(2) {
  color: #075c43;
  font-weight: 900;
}

/* GRADE */
.student-results-table .grade,
.student-results-table td:last-child strong {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 38px;
  min-height: 28px;
  padding: 4px 9px;
  border-radius: 8px;
  background: #eaf7f1;
  color: #075c43;
  font-weight: 900;
}

/* REMARK FIELD */
.student-results-table textarea {
  min-width: 150px;
  min-height: 38px;
  border: 1px solid #ccd9d2;
  border-radius: 8px;
  padding: 7px 9px;
  resize: vertical;
  outline: none;
}

.student-results-table textarea:focus {
  border-color: #087f5b;
  box-shadow: 0 0 0 3px rgba(8,127,91,.12);
}

/* TABLE EMPTY / LOADING */
.student-results-table td[colspan] {
  padding: 42px 20px;
  color: #78847e;
  text-align: center;
}

/* SUMMARY */
.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.summary-item {
  padding: 14px;
  border: 1px solid #dfe8e3;
  border-radius: 12px;
  background: #f8faf9;
}

.summary-item .label {
  display: block;
  margin-bottom: 5px;
  color: #77837d;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .05em;
  text-transform: uppercase;
}

.summary-item .value {
  color: #064b37;
  font-size: 20px;
  font-weight: 900;
}

.summary-item.highlight {
  background: linear-gradient(135deg, #eaf7f1, #f5fbf8);
  border-color: #c9e6d8;
}

/* =========================================================
   BEHAVIOURAL WORKSPACE
   ========================================================= */

.behavioural-management-panel {
  background:
    linear-gradient(180deg, #fff 0%, #fffdf7 100%);
}

.behaviour-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.behaviour-item {
  padding: 11px;
  background: #fff;
  border: 1px solid #e4e8df;
  border-radius: 11px;
  transition: .18s ease;
}

.behaviour-item:hover {
  border-color: #d6bd72;
  box-shadow: 0 5px 15px rgba(121,87,8,.07);
}

.behaviour-item label {
  display: block;
  margin-bottom: 7px;
  color: #59655f;
  font-size: 11px;
  font-weight: 800;
}

.behaviour-rating {
  width: 100%;
  min-height: 38px;
  padding: 7px 9px;
  border: 1px solid #d5ddd7;
  border-radius: 8px;
  background: #fff;
  color: #29362f;
  font-size: 12px;
  font-weight: 750;
  outline: none;
}

.behaviour-rating:hover {
  border-color: #c5a53e;
}

.behaviour-rating:focus {
  border-color: #b18410;
  box-shadow: 0 0 0 3px rgba(201,154,36,.13);
}

/* BEHAVIOUR SUMMARY */
.behaviour-summary-card {
  margin-top: 14px;
  padding: 16px;
  border: 1px solid #eadcae;
  border-radius: 13px;
  background: linear-gradient(135deg, #fff8df, #fffdf5);
}

.behaviour-summary-card strong,
.behaviour-summary-card .summary-label {
  color: #705507;
}

.behaviour-summary-card .value {
  color: #604900;
  font-size: 22px;
  font-weight: 900;
}

.affective-key {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 12px;
}

.affective-key span {
  padding: 5px 8px;
  border-radius: 7px;
  background: #f4f5f1;
  color: #66716b;
  font-size: 10px;
  font-weight: 750;
}

/* MOBILE */
@media (max-width: 850px) {
  .summary-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 520px) {
  .behaviour-grid {
    grid-template-columns: 1fr;
  }

  .summary-grid {
    grid-template-columns: 1fr 1fr;
  }
}


/* =========================================================
   MARKAZ 2026 — FINAL POLISH
   PART 3/3
   ========================================================= */

/* ACTION BUTTONS */
.page-header button,
.header-actions button,
button.btn,
.btn {
  border-radius: 9px;
  font-weight: 750;
  transition: all .18s ease;
}

.page-header button:hover,
.header-actions button:hover,
button.btn:hover,
.btn:hover {
  transform: translateY(-1px);
}

/* PRIMARY ACTIONS */
#saveResult,
#editResult,
button.primary,
.btn-primary {
  background: #087f5b;
  border-color: #087f5b;
  color: #fff;
  box-shadow: 0 4px 12px rgba(8,127,91,.15);
}

#saveResult:hover,
#editResult:hover,
button.primary:hover,
.btn-primary:hover {
  background: #075c43;
  border-color: #075c43;
  box-shadow: 0 7px 17px rgba(8,127,91,.2);
}

/* CANCEL */
#cancelEdit {
  background: #fff;
  border: 1px solid #d4ddd8;
  color: #59655f;
}

#cancelEdit:hover {
  border-color: #c54b4b;
  color: #c54b4b;
}

/* PRINT / PDF */
#printResult,
#downloadPdf {
  background: #fff7df;
  border: 1px solid #e5ca76;
  color: #765907;
  font-weight: 800;
}

#printResult:hover,
#downloadPdf:hover {
  background: #fff0bd;
}

/* REMARKS */
.remarks-section {
  margin: 0 24px 24px;
  padding: 18px;
  background: #fff;
  border: 1px solid #e1e8e4;
  border-radius: 17px;
  box-shadow: 0 7px 22px rgba(9,55,39,.06);
}

.remarks-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.remark-box {
  padding: 14px;
  background: #f8faf9;
  border: 1px solid #e1e8e4;
  border-radius: 11px;
}

.remark-box label {
  display: block;
  margin-bottom: 7px;
  color: #075c43;
  font-size: 11px;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: .04em;
}

.remark-box textarea,
.remarks-section textarea {
  width: 100%;
  min-height: 82px;
  padding: 10px;
  resize: vertical;
  border: 1px solid #d2ddd7;
  border-radius: 8px;
  background: #fff;
  color: #17231e;
  outline: none;
}

.remark-box textarea:focus,
.remarks-section textarea:focus {
  border-color: #087f5b;
  box-shadow: 0 0 0 3px rgba(8,127,91,.11);
}

/* SIGNATURES */
.signatures {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 45px;
  margin: 24px;
}

.signature-box {
  text-align: center;
}

.signature-line {
  width: min(220px, 100%);
  height: 1px;
  margin: 30px auto 7px;
  background: #8d9892;
}

.signature-box span {
  color: #69756f;
  font-size: 11px;
  font-weight: 700;
}

/* FOOTER */
.report-footer,
.school-footer {
  padding: 18px 24px;
  background: #f5f8f6;
  border-top: 1px solid #e1e8e4;
  color: #718078;
  text-align: center;
  font-size: 11px;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 850px) {
  .remarks-section {
    margin: 0 14px 18px;
  }

  .remarks-grid {
    grid-template-columns: 1fr;
  }

  .signatures {
