    align-items: start;
    gap: 20px;
    padding: 0 24px 24px;
    width: 100%;
    box-sizing: border-box;
}

.report-card .management-panel {
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    background: #fff;
    border: 1px solid #e1e8e4;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(9,55,39,.055);
}

/* LEFT — RESULTS */
.report-card .academic-management-panel {
    min-width: 0;
}

.report-card .academic-management-panel .report-section {
    margin: 0;
}

/* RIGHT — BEHAVIOUR */
.report-card .behavioural-management-panel {
    min-width: 0;
}

.report-card .behavioural-management-panel .report-section {
    margin: 0;
}

/* SECTION HEADINGS */
.report-card .management-panel .section-heading {
    padding: 20px 20px 16px;
    margin: 0;
    border-bottom: 1px solid #e8eeeb;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbf9 100%);
}

.report-card .management-panel .section-heading h2 {
    margin: 4px 0 5px;
    color: #12372b;
    font-size: 18px;
    line-height: 1.25;
    font-weight: 900;
}

.report-card .management-panel .section-heading p {
    margin: 0;
    color: #718078;
    font-size: 11px;
    line-height: 1.5;
}

.report-card .section-eyebrow {
    color: #087f5b;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .1em;
}

/* RESULTS TABLE */
.report-card .results-table-container {
    width: 100%;
    overflow-x: auto;
    overflow-y: visible;
    padding: 0;
}

.report-card .student-results-table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    table-layout: auto;
}

.report-card .student-results-table th {
    padding: 11px 9px;
    background: #075c43;
    color: #fff;
    border: 0;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .03em;
    white-space: nowrap;
}

.report-card .student-results-table td {
    padding: 10px 9px;
    border-bottom: 1px solid #edf1ef;
    color: #26352e;
    font-size: 12px;
    vertical-align: middle;
    white-space: nowrap;
}

.report-card .student-results-table tbody tr:nth-child(even) {
    background: #f8fbf9;
}

.report-card .student-results-table tbody tr:hover {
    background: #eef8f3;
}

.report-card .student-results-table th:first-child,
.report-card .student-results-table td:first-child {
    width: 42px;
    text-align: center;
}

.report-card .student-results-table th:nth-child(2),
.report-card .student-results-table td:nth-child(2) {
    min-width: 150px;
    text-align: left;
}

.report-card .student-results-table th:not(:nth-child(2)),
.report-card .student-results-table td:not(:nth-child(2)) {
    text-align: center;
}

/* SCORE INPUTS */
.report-card .result-score-input {
    width: 62px;
    height: 34px;
    padding: 5px 7px;
    border: 1px solid #cbd9d2;
    border-radius: 8px;
    background: #fff;
    color: #12372b;
    text-align: center;
    font-weight: 800;
    outline: none;
    box-sizing: border-box;
}

.report-card .result-score-input:focus {
    border-color: #087f5b;
    box-shadow: 0 0 0 3px rgba(8,127,91,.12);
}

.report-card .result-grade {
    display: inline-grid;
    place-items: center;
    min-width: 30px;
    height: 28px;
    padding: 0 7px;
    border-radius: 7px;
    background: #eef7f2;
    color: #075c43;
    font-weight: 900;
}

.report-card .result-remark {
    color: #68766f;
    font-weight: 700;
}

/* RESULT SUMMARY */
.report-card .academic-management-panel .report-section + .report-section {
    border-top: 1px solid #e1e8e4;
}

.report-card .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    padding: 16px;
}

.report-card .summary-box {
    min-width: 0;
    padding: 13px;
    border: 1px solid #e1e8e4;
    border-radius: 11px;
    background: #f8fbf9;
}

.report-card .summary-box span {
    display: block;
    margin-bottom: 5px;
    color: #718078;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
}

.report-card .summary-box strong {
    color: #075c43;
    font-size: 18px;
    font-weight: 900;
}

/* BEHAVIOURAL LIST — NO OVERLAPPING */
.report-card .behaviour-grid {
    display: grid !important;
    grid-template-columns: 1fr;
    gap: 0;
    padding: 8px 16px 16px;
}

.report-card .behaviour-item {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) 150px;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    padding: 8px 0;
    border-bottom: 1px solid #edf1ef;
    box-sizing: border-box;
}

.report-card .behaviour-item:last-child {
    border-bottom: 0;
}

.report-card .behaviour-item > span {
    min-width: 0;
    color: #26352e;
    font-size: 12px;
    font-weight: 750;
}

.report-card .behaviour-rating {
    width: 100%;
    min-width: 0;
    height: 36px;
    padding: 0 9px;
    border: 1px solid #cbd9d2;
    border-radius: 8px;
    background: #fff;
    color: #26352e;
    font-size: 11px;
    font-weight: 700;
    outline: none;
    box-sizing: border-box;
}

.report-card .behaviour-rating:focus {
    border-color: #087f5b;
    box-shadow: 0 0 0 3px rgba(8,127,91,.11);
}

/* BEHAVIOUR SUMMARY */
.report-card .behaviour-summary-card {
    margin: 4px 16px 16px;
    padding: 15px;
    border: 1px solid #e5ca76;
    border-radius: 11px;
    background: #fffaf0;
}

.report-card .behaviour-summary-card strong {
    color: #765907;
}

/* MOBILE */
@media (max-width: 950px) {
    .report-card .result-management-grid {
        grid-template-columns: 1fr;
    }

    .report-card .summary-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 650px) {
    .report-card .school-header {
        grid-template-columns: 64px minmax(0, 1fr);
        gap: 14px;
        padding: 18px;
    }

    .report-card .school-logo {
        width: 62px !important;
        height: 62px !important;
        min-width: 62px;
        min-height: 62px;
    }

    .report-card .school-name {
        font-size: 19px;
    }

    .report-card .school-arabic-name {
        font-size: 12px;
    }

    .report-card .result-management-grid {
        padding: 0 14px 18px;
        gap: 14px;
    }

    .report-card .summary-grid {
        grid-template-columns: 1fr 1fr;
        padding: 12px;
    }

    .report-card .behaviour-item {
        grid-template-columns: 1fr;
        gap: 6px;
        padding: 10px 0;
    }

    .report-card .behaviour-rating {
        height: 38px;
    }
}

@media print {
    .report-card .result-management-grid {
        display: grid !important;
        grid-template-columns: 1.5fr 1fr;
        gap: 12px;
        padding: 0;
    }

    .report-card .school-header {
        grid-template-columns: 76px minmax(0, 1fr) auto;
    }
}

