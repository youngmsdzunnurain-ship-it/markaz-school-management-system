:root {
    --green: #17643a;
    --green-dark: #0d2b1c;
    --green-soft: #e8f2eb;
    --gold: #c8a43a;
    --gold-soft: #f4e8b7;
    --cream: #f7f4eb;
    --background: #f3f6f2;
    --white: #ffffff;
    --text: #173125;
    --muted: #718078;
    --border: #e1e8e3;
    --danger: #b84040;
    --shadow-sm: 0 4px 16px rgba(20,55,38,.06);
    --shadow-md: 0 12px 30px rgba(20,55,38,.09);
    --sidebar-width: 270px;
    --transition: .25s ease;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    font-family: Inter, "Segoe UI", Arial, sans-serif;
    color: var(--text);
    background:
        radial-gradient(circle at top right, rgba(200,164,58,.08), transparent 28%),
        var(--background);
}

button,
input {
    font: inherit;
}

button {
    cursor: pointer;
}

img {
    display: block;
    max-width: 100%;
}

.app {
    min-height: 100vh;
    display: flex;
}

/* SIDEBAR */

.sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 1000;
    width: var(--sidebar-width);
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg,#123d2a 0%,#0d2b1c 100%);
    border-right: 1px solid rgba(255,255,255,.08);
    box-shadow: 8px 0 30px rgba(0,0,0,.08);
    transition: width var(--transition),transform var(--transition);
}

.sidebar::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg,var(--gold),#ead58a,var(--gold));
}

.sidebar-header {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 28px 18px 18px;
}

.brand-logo {
    width: 52px;
    height: 52px;
    flex: 0 0 52px;
    padding: 4px;
    background: var(--white);
    border-radius: 14px;
    box-shadow: 0 6px 20px rgba(0,0,0,.18);
}

.brand-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 10px;
}

.brand-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.brand-text strong {
    color: var(--white);
    font-size: 18px;
    letter-spacing: 1px;
}

.brand-text span {
    margin-top: 3px;
    color: rgba(255,255,255,.62);
    font-size: 11px;
}

.sidebar-close-button {
    display: none;
    width: 36px;
    height: 36px;
    margin-left: auto;
    border: 0;
    border-radius: 10px;
    color: var(--white);
    background: rgba(255,255,255,.08);
}

.sidebar-school {
    margin: 4px 18px 22px;
    padding: 14px;
    border: 1px solid rgba(200,164,58,.2);
    border-radius: 14px;
    background: rgba(255,255,255,.045);
}

.sidebar-school span,
.sidebar-school strong {
    display: block;
}

.sidebar-school span {
    color: rgba(255,255,255,.55);
    font-size: 10px;
}

.sidebar-school strong {
    margin-top: 3px;
    color: var(--gold-soft);
    font-size: 11px;
    line-height: 1.45;
}

.sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 0 12px;
    overflow-y: auto;
}

.nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 13px;
    min-height: 48px;
    padding: 0 14px;
    color: rgba(255,255,255,.67);
    text-decoration: none;
    border-radius: 12px;
    transition: var(--transition);
}

.nav-link i {
    width: 20px;
    text-align: center;
    font-size: 15px;
}

.nav-link span {
    font-size: 13px;
    font-weight: 600;
}

.nav-link:hover {
    color: var(--white);
    background: rgba(255,255,255,.07);
}

.nav-link.active {
    color: var(--white);
    background: linear-gradient(90deg,rgba(200,164,58,.22),rgba(255,255,255,.06));
}

.nav-link.active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 3px;
    background: var(--gold);
    border-radius: 0 4px 4px 0;
}

.sidebar-bottom {
    margin-top: auto;
    padding: 14px 12px 18px;
}

.sidebar-divider {
    height: 1px;
    margin-bottom: 12px;
    background: rgba(255,255,255,.08);
}

.logout-button {
    width: 100%;
    min-height: 46px;
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 0 14px;
    border: 0;
    border-radius: 12px;
    color: rgba(255,255,255,.68);
    background: transparent;
}

.logout-button i {
    width: 20px;
    text-align: center;
}

.logout-button span {
    font-size: 13px;
    font-weight: 600;
}

.logout-button:hover {
    color: #ffd5d5;
    background: rgba(184,64,64,.15);
}

/* MAIN */

.main-content {
    width: calc(100% - var(--sidebar-width));
    min-height: 100vh;
    margin-left: var(--sidebar-width);
    display: flex;
    flex-direction: column;
    transition: var(--transition);
}

.page-content {
    flex: 1;
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: 28px 32px 36px;
}

/* TOPBAR */

.topbar {
    position: sticky;
    top: 0;
    z-index: 500;
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 32px;
    background: rgba(255,255,255,.94);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
}

.topbar-left,
.topbar-right {
    display: flex;
    align-items: center;
}

.topbar-left {
    gap: 15px;
}

.topbar-right {
    gap: 12px;
}

.menu-button {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 11px;
    color: var(--green);
    background: var(--white);
    box-shadow: var(--shadow-sm);
}

.menu-button:hover {
    color: var(--white);
    background: var(--green);
    border-color: var(--green);
}

.page-heading {
    display: flex;
    flex-direction: column;
}

.heading-label {
    color: var(--gold);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.page-heading h1 {
    margin-top: 2px;
    color: var(--green-dark);
    font-size: 24px;
    line-height: 1.15;
}

/* SEARCH */

.global-search {
    width: min(340px,30vw);
    height: 43px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--background);
}

.global-search:focus-within {
    border-color: var(--green);
    background: var(--white);
    box-shadow: 0 0 0 3px rgba(23,100,58,.08);
}

.global-search i {
    color: var(--muted);
    font-size: 13px;
}

.global-search input {
    width: 100%;
    border: 0;
    outline: 0;
    color: var(--text);
    background: transparent;
    font-size: 12px;
}

.global-search input::placeholder {
    color: #9aa59f;
}

.topbar-icon-button {
    position: relative;
    width: 43px;
    height: 43px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--green);
    background: var(--white);
}

.notification-dot {
    position: absolute;
    top: 9px;
    right: 10px;
    width: 6px;
    height: 6px;
    border: 1px solid var(--white);
    border-radius: 50%;
    background: var(--gold);
}

/* PROFILE */

.admin-profile-wrapper {
    position: relative;
}

.admin-profile-button {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 4px 5px 4px 4px;
    border: 1px solid transparent;
    border-radius: 13px;
    background: transparent;
}

.admin-profile-button:hover,
.admin-profile-button[aria-expanded="true"] {
    background: var(--background);
    border-color: var(--border);
}

.admin-avatar,
.profile-large-avatar {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--white);
    background: linear-gradient(145deg,var(--green),var(--green-deep));
    border: 2px solid var(--gold-soft);
}

.admin-avatar {
    width: 38px;
    height: 38px;
    border-radius: 11px;
}

.profile-large-avatar {
    width: 46px;
    height: 46px;
    border-radius: 13px;
}

.admin-avatar span,
.profile-large-avatar span {
    font-size: 11px;
    font-weight: 800;
}

.admin-profile-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.admin-profile-text strong {
    max-width: 130px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text);
    font-size: 12px;
}

.admin-profile-text span {
    margin-top: 2px;
    color: var(--muted);
    font-size: 10px;
}

.profile-chevron {
    margin-left: 3px;
    color: var(--muted);
    font-size: 10px;
}

/* WELCOME */

.welcome-card {
    position: relative;
    overflow: hidden;
    min-height: 190px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 34px 38px;
    border: 1px solid rgba(200,164,58,.24);
    border-radius: 22px;
    background: linear-gradient(115deg,#123d2a 0%,#17643a 65%,#2b7750 100%);
    box-shadow: var(--shadow-md);
}

.welcome-content {
    position: relative;
    z-index: 2;
    max-width: 730px;
}

.eyebrow {
    color: var(--gold);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.7px;
}

.welcome-card .eyebrow {
    color: var(--gold-soft);
}

.welcome-card h2 {
    margin-top: 9px;
    color: var(--white);
    font-size: clamp(25px,3vw,36px);
    line-height: 1.15;
}

.welcome-card h2 span:first-of-type {
    color: var(--gold-soft);
}

.welcome-card p {
    max-width: 650px;
    margin-top: 12px;
    color: rgba(255,255,255,.72);
    font-size: 13px;
    line-height: 1.7;
}

.welcome-wave {
    display: inline-block;
    margin-left: 4px;
}

.welcome-decoration {
    position: relative;
    width: 150px;
    height: 150px;
    margin-right: 25px;
}

.welcome-decoration > i {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgba(255,255,255,.88);
    font-size: 52px;
    z-index: 2;
}

.decoration-circle {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.16);
}

.circle-one {
    inset: 5px;
    background: rgba(200,164,58,.12);
}

.circle-two {
    inset: 30px;
    background: rgba(255,255,255,.05);
}

/* STATISTICS */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    gap: 17px;
    margin-top: 22px;
}

.stat-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 125px;
    padding: 20px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 17px;
    background: var(--white);
    box-shadow: var(--shadow-sm);
}

.stat-card::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 3px;
    background: var(--gold);
}

.stat-icon {
    width: 50px;
    height: 50px;
    flex: 0 0 50px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    font-size: 17px;
}

.students-icon {
    color: var(--green);
    background: var(--green-soft);
}

.classes-icon {
    color: #876d19;
    background: var(--gold-soft);
}

.subjects-icon {
    color: #3c6f9c;
    background: #e8f1f8;
}

.results-icon {
    color: #72539b;
    background: #f0eafa;
}

.stat-information {
    min-width: 0;
}

.stat-label,
.stat-information strong,
.stat-information small {
    display: block;
}

.stat-label {
    color: var(--muted);
    font-size: 10px;
    font-weight: 600;
}

.stat-information strong {
    margin-top: 3px;
    color: var(--green-dark);
    font-size: 24px;
}

.stat-information small {
    margin-top: 2px;
    color: #9aa59f;
    font-size: 9px;
}

/* PROFILE DROPDOWN */

.profile-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 270px;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--white);
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: var(--transition);
}

.profile-dropdown.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.profile-dropdown-header {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 10px;
}

.profile-dropdown-header strong,
.profile-dropdown-header span {
    display: block;
}

.profile-dropdown-header strong {
    color: var(--green-dark);
    font-size: 13px;
}

.profile-dropdown-header span {
    max-width: 175px;
    margin-top: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
    font-size: 10px;
}

.profile-divider {
    height: 1px;
    margin: 4px 8px 8px;
    background: var(--border);
}

.profile-menu-item {
    width: 100%;
    min-height: 42px;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 0 11px;
    border: 0;
    border-radius: 10px;
    color: var(--text);
    background: transparent;
    text-align: left;
}

.profile-menu-item:hover {
    background: var(--green-soft);
}

.profile-menu-item i {
    width: 18px;
    color: var(--green);
    text-align: center;
}

.profile-menu-item span {
    font-size: 11px;
    font-weight: 600;
}

.profile-menu-item.danger {
    color: var(--danger);
}

.profile-menu-item.danger i {
    color: var(--danger);
}

/* DASHBOARD PANELS */

.dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0,1.4fr) minmax(320px,.9fr);
    gap: 20px;
    margin-top: 22px;
}

.panel {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--white);
    box-shadow: var(--shadow-sm);
}

.panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 20px;
}

.panel-header h3 {
    margin-top: 5px;
    color: var(--green-dark);
    font-size: 19px;
}

.panel-header-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    color: var(--green);
    background: var(--green-soft);
}

.gold-icon {
    color: #856b16;
    background: var(--gold-soft);
}

/* QUICK ACTIONS */

.quick-actions {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 10px;
}

.quick-actions button {
    min-height: 72px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 13px;
    color: var(--text);
    background: #fbfcfb;
    text-align: left;
    transition: var(--transition);
}

.quick-actions button:hover {
    border-color: rgba(23,100,58,.3);
    background: var(--green-soft);
    transform: translateY(-2px);
}

.quick-actions button > i {
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    display: grid;
    place-items: center;
    color: var(--green);
    background: var(--white);
    border-radius: 10px;
}

.quick-actions button strong,
.quick-actions button small {
    display: block;
}

.quick-actions button strong {
    color: var(--green-dark);
    font-size: 11px;
}

.quick-actions button small {
    margin-top: 3px;
    color: var(--muted);
    font-size: 9px;
}

/* ADMIN DETAILS */

.admin-details {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
}

.admin-detail-row {
    min-height: 57px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    border-bottom: 1px solid var(--border);
}

.detail-label {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
}

.detail-label i {
    width: 17px;
    color: var(--green);
    text-align: center;
}

.detail-label span {
    font-size: 11px;
}

.admin-detail-row > strong {
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--green-dark);
    font-size: 11px;
}

.status-active {
    color: var(--green) !important;
}

.account-note {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 18px;
    padding: 12px;
    border-radius: 11px;
    color: var(--green-deep);
    background: var(--green-soft);
}

.account-note span {
    font-size: 9px;
    line-height: 1.55;
}

/* SCHOOL IDENTITY */

.school-identity-card {
    display: flex;
    align-items: center;
    gap: 17px;
    margin-top: 22px;
    padding: 19px 22px;
    border: 1px solid rgba(200,164,58,.24);
    border-radius: 17px;
    background: linear-gradient(135deg,#fffdf7,#f8f4e7);
}

.school-identity-logo {
    width: 60px;
    height: 60px;
    flex: 0 0 60px;
    padding: 4px;
    border: 1px solid var(--gold-soft);
    border-radius: 14px;
    background: var(--white);
}

.school-identity-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 10px;
}

.school-identity-text {
    display: flex;
    flex-direction: column;
}

.school-identity-text span {
    color: var(--gold);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.school-identity-text strong {
    max-width: 700px;
    margin-top: 3px;
    color: var(--green-dark);
    font-size: 13px;
    line-height: 1.45;
}

.school-identity-text small {
    margin-top: 3px;
    color: var(--muted);
    font-size: 9px;
}

/* FOOTER */

.site-footer {
    margin-top: auto;
    padding: 0 32px;
    color: rgba(255,255,255,.7);
    background: var(--green-dark);
    border-top: 3px solid var(--gold);
}

.footer-content {
    min-height: 92px;
    max-width: 1500px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
}

.footer-brand {
    display: flex;
    align-items: center;
    gap: 11px;
}

.footer-logo {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    padding: 3px;
    background: var(--white);
    border-radius: 10px;
}

.footer-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 7px;
}

.footer-brand strong,
.footer-brand span {
    display: block;
}

.footer-brand strong {
    color: var(--gold-soft);
    font-size: 12px;
    letter-spacing: 1px;
}

.footer-brand span {
    max-width: 440px;
    margin-top: 3px;
    color: rgba(255,255,255,.58);
    font-size: 9px;
    line-height: 1.4;
}

.footer-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    font-size: 9px;
}

/* MOBILE OVERLAY */

.sidebar-overlay {
    position: fixed;
    inset: 0;
    z-index: 900;
    background: rgba(4,20,12,.48);
    opacity: 0;
    visibility: hidden;
    transition: var(--transition);
}

.sidebar-overlay.visible {
    opacity: 1;
    visibility: visible;
}

/* RESPONSIVE */

@media (max-width:1150px) {
    .stats-grid {
        grid-template-columns: repeat(2,minmax(0,1fr));
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .global-search {
        width: 250px;
    }
}

@media (max-width:850px) {
    .sidebar {
        transform: translateX(-105%);
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .sidebar-close-button {
        display: grid;
        place-items: center;
    }

    .main-content {
        width: 100%;
        margin-left: 0;
    }

    .topbar {
        padding: 12px 18px;
    }

    .page-content {
        padding: 22px 18px 30px;
    }

    .global-search {
        width: min(270px,35vw);
    }

    .welcome-decoration {
        margin-right: 0;
    }

    .site-footer {
        padding: 0 18px;
    }
}

@media (max-width:650px) {
    .topbar {
        min-height: 72px;
    }

    .page-heading h1 {
        font-size: 20px;
    }

