        -webkit-backdrop-filter: blur(3px);

        opacity: 0;
        visibility: hidden;
        pointer-events: none;

        transition:
            opacity .25s ease,
            visibility .25s ease;
    }

    .sidebar-overlay.visible {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .main-content {
        width: 100%;
        margin-left: 0;
    }

    .nav-link {
        min-height: 50px;
        margin: 4px 12px;
        padding: 0 16px;

        display: flex;
        align-items: center;

        border-radius: 12px;

        transition:
            background-color .18s ease,
            transform .18s ease,
            color .18s ease;
    }

    .nav-link:active {
        transform: translateX(2px);
    }

    body:has(.sidebar.open) {
        overflow: hidden;
    }
}

/* =========================================================
   DESKTOP SIDEBAR
