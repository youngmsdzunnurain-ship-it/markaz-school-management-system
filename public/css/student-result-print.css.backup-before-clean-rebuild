@page {
    size: A4 portrait;
    margin: 6mm;
}

@media print {
    html, body {
        margin: 0 !important;
        padding: 0 !important;
        background: #fff !important;
        color: #17211b !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }

    .page-header,
    .header-actions,
    button,
    .btn,
    .no-print {
        display: none !important;
    }

    .student-result-page,
    .report-card {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
        border: 0 !important;
        box-shadow: none !important;
        background: #fff !important;
    }
}

@media print {
    .school-header {
        display: grid !important;
        grid-template-columns: 52px 1fr auto !important;
        gap: 7px !important;
        align-items: center !important;
        padding: 0 0 4px !important;
        margin-bottom: 4px !important;
        border-bottom: 2px solid #1f6b45 !important;
    }

    .school-logo,
    #schoolLogo {
        width: 50px !important;
        height: 50px !important;
        object-fit: contain !important;
        border-radius: 50% !important;
        border: 1px solid #c6a34a !important;
    }

    .school-arabic-name {
        margin: 0 !important;
        font-size: 13px !important;
        line-height: 1.1 !important;
    }

    .school-arabic-address,
    .school-phone,
    .school-email {
        font-size: 6px !important;
        line-height: 1.1 !important;
    }

    .school-kicker {
        margin: 1px 0 !important;
        font-size: 7px !important;
        line-height: 1.1 !important;
    }

    .report-title {
        text-align: right !important;
        white-space: nowrap !important;
    }

    .report-title h1,
    .report-title h2 {
        margin: 0 !important;
        font-size: 10px !important;
    }

    .session-bar {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 4px !important;
        padding: 3px 5px !important;
        margin-bottom: 4px !important;
        background: #edf6f0 !important;
        border: 1px solid #c9ddcf !important;
    }

    .session-bar * {
        font-size: 6.5px !important;
    }
}

@media print {
    .report-section {
        margin: 0 0 4px !important;
    }

    .student-profile-grid {
        display: grid !important;
        grid-template-columns: 55px 1fr !important;
        gap: 7px !important;
        align-items: start !important;
    }

    .student-photo,
    #studentPhoto,
    #studentPhotoInitials {
        width: 55px !important;
        height: 65px !important;
        max-width: 55px !important;
        max-height: 65px !important;
        object-fit: cover !important;
        border: 1px solid #c6a34a !important;
        border-radius: 3px !important;
    }

    .student-details {
        display: grid !important;
        grid-template-columns: repeat(4, 1fr) !important;
        gap: 3px !important;
    }

    .detail-item {
        min-width: 0 !important;
        padding: 3px 4px !important;
        border: 1px solid #dbe6df !important;
        border-radius: 2px !important;
        background: #fbfdfb !important;
    }

    .detail-item span,
    .detail-item small {
        display: block !important;
        font-size: 5.5px !important;
        line-height: 1 !important;
    }

    .detail-item strong,
    .detail-item b,
    .detail-item .value {
        display: block !important;
        margin-top: 1px !important;
        font-size: 7px !important;
        line-height: 1.1 !important;
    }

    .student-name-item {
        grid-column: span 2 !important;
    }
}

@media print {
    .result-management-grid,
    .academic-management-panel,
    .results-table-container {
        display: block !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow: visible !important;
    }

    .student-results-table {
        width: 100% !important;
        border-collapse: collapse !important;
        table-layout: fixed !important;
        margin: 0 !important;
        font-size: 6.5px !important;
    }

    .student-results-table th,
    .student-results-table td {
        padding: 2px 3px !important;
        line-height: 1.15 !important;
        border: 1px solid #cbd8d0 !important;
        vertical-align: middle !important;
    }

    .student-results-table th {
        background: #1f6b45 !important;
        color: #fff !important;
        font-size: 6px !important;
        font-weight: 700 !important;
    }

    .student-results-table th:nth-child(1),
    .student-results-table td:nth-child(1) {
        width: 4% !important;
        text-align: center !important;
    }

    .student-results-table th:nth-child(2),
    .student-results-table td:nth-child(2) {
        width: 27% !important;
        text-align: left !important;
    }

    .student-results-table th:nth-child(3),
    .student-results-table td:nth-child(3),
    .student-results-table th:nth-child(4),
    .student-results-table td:nth-child(4),
    .student-results-table th:nth-child(5),
    .student-results-table td:nth-child(5),
    .student-results-table th:nth-child(6),
    .student-results-table td:nth-child(6) {
        width: 10% !important;
        text-align: center !important;
    }

    .student-results-table th:nth-child(7),
    .student-results-table td:nth-child(7) {
        width: 9% !important;
        text-align: center !important;
    }

    .student-results-table th:nth-child(8),
    .student-results-table td:nth-child(8) {
        width: 10% !important;
        text-align: center !important;
    }

    .result-grade {
        font-weight: 700 !important;
    }
}

@media print {
    /* Academic summary */
    .academic-summary,
    .result-summary,
    .summary-grid {
        display: grid !important;
        grid-template-columns: repeat(4, 1fr) !important;
        gap: 3px !important;
        margin: 3px 0 !important;
    }

    .academic-summary > *,
    .result-summary > *,
    .summary-grid > * {
        padding: 3px 4px !important;
        border: 1px solid #dbe6df !important;
        border-radius: 2px !important;
    }

    /* Behaviour below academics */
    .behavioural-management-panel {
        width: 100% !important;
        margin: 4px 0 0 !important;
        padding: 0 !important;
    }

    .behaviour-grid {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 3px !important;
        width: 100% !important;
    }

    .behaviour-item {
        display: grid !important;
        grid-template-columns: 1fr auto !important;
        align-items: center !important;
        gap: 4px !important;
        min-height: 20px !important;
        padding: 3px 5px !important;
        border: 1px solid #dbe6df !important;
        border-radius: 2px !important;
        background: #fbfdfb !important;
    }

    .behaviour-item > span {
        font-size: 6.5px !important;
        font-weight: 700 !important;
    }

    .behaviour-rating {
        display: inline-block !important;
        min-width: 45px !important;
        max-width: 70px !important;
        padding: 1px 2px !important;
        font-size: 5.5px !important;
    }

    .behaviour-summary-card {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 5px !important;
        margin: 3px 0 !important;
        padding: 4px 5px !important;
        border: 1px solid #c6a34a !important;
        background: #fffdf5 !important;
    }

    .behaviour-summary-card * {
        font-size: 6px !important;
    }

    .behaviour-comment-card {
        margin: 3px 0 !important;
        padding: 4px 5px !important;
        border-left: 2px solid #1f6b45 !important;
        background: #f7faf8 !important;
    }

    .behaviour-comment-card p {
        margin: 2px 0 0 !important;
        font-size: 6.5px !important;
        line-height: 1.2 !important;
    }

    .affective-key {
        display: flex !important;
        justify-content: center !important;
        gap: 8px !important;
        margin: 2px 0 !important;
        font-size: 5px !important;
    }
}

@media print {
    /* Remarks */
    .remarks-section {
        margin-top: 4px !important;
    }

    .remarks-grid {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 5px !important;
    }

    .remark-card {
        min-height: 28px !important;
        padding: 4px 5px !important;
        border: 1px solid #dbe6df !important;
        border-radius: 2px !important;
        background: #fbfdfb !important;
    }

    .remark-card p {
        margin: 2px 0 0 !important;
        font-size: 6.5px !important;
        line-height: 1.2 !important;
    }

    /* Signatures */
    .report-footer {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 12px !important;
        margin-top: 5px !important;
        padding-top: 5px !important;
        border-top: 1px solid #cbd8d0 !important;
    }

    .signature-line {
        text-align: center !important;
    }

    .signature-space {
        min-height: 18px !important;
        margin-bottom: 2px !important;
        border-bottom: 1px solid #5f6d64 !important;
    }

    .signature-line span {
        display: block !important;
        font-size: 6.5px !important;
        font-weight: 700 !important;
    }

    .signature-line small {
        display: block !important;
        font-size: 5px !important;
    }

    /* Footer */
    .report-card-footer,
    .school-footer {
        margin-top: 3px !important;
        padding-top: 2px !important;
        border-top: 1px solid #dbe6df !important;
        font-size: 5px !important;
        text-align: center !important;
    }

    /* Keep small logical pieces together */
    .student-information,
    .student-results-table tr,
    .behaviour-item,
    .behaviour-summary-card,
    .behaviour-comment-card,
    .remark-card {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
    }
}



@media print {
    @page {
        size: A4 portrait;
        margin: 6mm;
    }

    body {
        zoom: 1 !important;
    }

    .report-card,
    .result-management-grid,
    .academic-management-panel,
    .behavioural-management-panel {
        display: block !important;
        width: 100% !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        overflow: visible !important;
    }

    /* Academic results occupy the full width first */
    .academic-management-panel {
        margin: 0 0 4px !important;
        padding: 0 !important;
    }

    /* Behavioural report is BELOW academic results */
    .behavioural-management-panel {
        clear: both !important;
        margin: 4px 0 0 !important;
        padding: 0 !important;
    }

    .behaviour-grid {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 3px !important;
        width: 100% !important;
    }

    .student-results-table {
        width: 100% !important;
        table-layout: fixed !important;
        margin: 0 !important;
    }

    .remarks-section,
    .report-footer,
    .report-card-footer {
        width: 100% !important;
    }
}

